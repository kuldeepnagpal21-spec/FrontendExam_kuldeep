
<!DOCTYPE html>
<html>
<head>
<title>Profile Card</title>
<style>
body {
  font-family: Arial;
  background: #eee;
  display: flex;
  justify-content: center;
  padding-top: 50px;
}
.card {
  width: 300px;
  background: white;
  text-align: center;
  border-radius: 15px;
  overflow: hidden;
  box-shadow: 0 5px 15px #aaa;
  padding-bottom: 25px;
}
.banner {
  height: 100px;
  background: linear-gradient(90deg, blue, purple);
}
.avatar {
  width: 90px;
  height: 90px;
  background: #ffcc00;
  border: 4px solid white;
  border-radius: 50%;
  margin: -45px auto 10px;
  position: relative;
  display: grid;
  place-items: center;
  font-size: 28px;
  font-weight: bold;
}
ul {
  list-style: none;
  padding: 0;
}
li {
  display: inline-block;
  background: #eee;
  padding: 8px;
  margin: 4px;
  border-radius: 20px;
}
button {
  background: blue;
  color: white;
  padding: 12px 30px;
  border: 2px solid blue;
  border-radius: 25px;
  cursor: pointer;
}
button.following {
  background: white;
  color: blue;
}
</style>
</head>
<body>

<div class="card">
  <div class="banner"></div>
  <div class="avatar">AK</div>
  <h2>Arjun Kumar</h2>
  <p>Web Developer</p>

  <ul>
    <li>HTML</li>
    <li>CSS</li>
    <li>JavaScript</li>
    <li>Git</li>
  </ul>

  <p id="count">120 followers</p>
  <button id="btn" onclick="follow()">
    Follow
  </button>
</div>

<script>
function follow() {
  let btn = document.getElementById("btn");
  let count = document.getElementById("count");

  btn.classList.toggle("following");

  if (btn.classList.contains("following")) {
    btn.innerText = "Following";
    count.innerText = "121 followers";
  } else {
    btn.innerText = "Follow";
    count.innerText = "120 followers";
  }
}
</script>

</body>
</html>



